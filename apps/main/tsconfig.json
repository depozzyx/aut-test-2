{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": "src",
    "paths": {
      "@/utils/*": ["utils/*"],
      "@/styled/*": ["styled/*"],
      "@/html/*": ["html/*"],
      "@/store": ["store"],
      "@/inputs/*": ["components/inputs/*"],
      "@/types/*": ["types/*"],
      "@/icons/*": ["components/icons/*"],
      "@/components/*": ["components/*"],
      "@/containers/*": ["containers/*"],
      "@/hooks/*": ["hooks/*"],
      "@/features/*": ["features/*"],
      "@/browser-api/*": ["api/browser-api/*"],
      "@/constants/*": ["constants/*"],
      "@/seo/*": ["seo/*"],
      "@/layout/*": ["layout/*"],
      "@/routes": ["constants/routes"],
      "@/api-rest/*": ["api/rest/*"]
    },
    "typeRoots": [
      "../../node_modules/@peiko/styled/types", 
      "../../node_modules/@peiko/types/declare",
      "../../node_modules/@types"
    ],
    "types": ["axios", "default-theme", "images"]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
